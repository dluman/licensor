# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# =============================================================================
# RAILS TEMPORARY & GENERATED FILES
# =============================================================================

# Log files (all log files anywhere in the tree)
*.log
/log/*
!/log/.keep

# Temp directory — entirely generated at runtime by Rails, Puma, and Bootsnap.
# All contents (bootsnap cache, restart signals, PID files, sockets) are
# ephemeral and recreated on boot.
/tmp/

# =============================================================================
# CREDENTIALS & SECRETS
# =============================================================================

# Rails master key — decrypts credentials. NEVER commit this.
/config/master.key

# Encrypted credentials file. Some teams commit this (it is useless without
# master.key), but ignoring it is safer to avoid leaking encrypted blobs.
/config/credentials.yml.enc

# Kamal deployment secrets. The default template is safe, but once populated
# it can contain registry passwords and other secrets.
/.kamal/secrets

# =============================================================================
# BUNDLER & GEM ARTIFACTS
# =============================================================================

# Bundler config and local gem paths
/.bundle
/vendor/bundle
/vendor/cache

# Built gem packages
*.gem
/pkg/

# =============================================================================
# RUBY TOOLING
# =============================================================================

# Ruby compiled bytecode
*.rbc

# Byebug history
.byebug_history

# Spring application preloader PID/state
/spring/*.pid

# =============================================================================
# EDITOR & IDE
# =============================================================================

# VS Code
.vscode/

# RubyMine / IntelliJ
.idea/
*.iml

# Vim swap files
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock

# =============================================================================
# ENVIRONMENT & OS
# =============================================================================

# Environment variable files
/.env*

# RVM / rbenv version manager files
.rvmrc
.rbenv-version

# OS metadata files
.DS_Store
Thumbs.db

# =============================================================================
# DOCUMENTATION & TESTING
# =============================================================================

# Generated documentation
/doc/
/.yardoc

# Test coverage reports
coverage/

# =============================================================================
# ASSETS & FRONTEND (if ever added)
# =============================================================================

# Compiled assets
/public/assets

# Node modules (if JavaScript is introduced later)
/node_modules/
/yarn-error.log
